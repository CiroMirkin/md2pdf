#!/usr/bin/env python3
"""Agrupa las acciones md2pdf en un submenu "PDF" de Nemo (~/.config/nemo/actions-tree.json). Idempotente."""
import json, sys
from pathlib import Path

ruta = Path(sys.argv[1]) if len(sys.argv) > 1 else Path.home() / ".config/nemo/actions-tree.json"
ACCIONES = ["md2pdf-simple.nemo_action", "md2pdf-doble.nemo_action", "md2pdf-paginado.nemo_action"]
GRUPO = "md2pdf-submenu"

try:
    datos = json.loads(ruta.read_text())
    datos["toplevel"]
except (FileNotFoundError, ValueError, KeyError):
    datos = {"toplevel": []}

def sin_md2pdf(nodos):
    return [n for n in nodos if n.get("uuid") != GRUPO and n.get("uuid") not in ACCIONES]

datos["toplevel"] = sin_md2pdf(datos["toplevel"])
datos["toplevel"].append({
    "uuid": GRUPO, "type": "submenu", "user-label": "PDF",
    "children": [{"uuid": a, "type": "action"} for a in ACCIONES],
})
ruta.parent.mkdir(parents=True, exist_ok=True)
ruta.write_text(json.dumps(datos, indent=2))
print(f"submenu PDF escrito en {ruta}")
